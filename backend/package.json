{
  "name": "the-watch-backend",
  "version": "1.0.0",
  "description": "Enterprise Monitoring, Observability & Threat Intelligence Backend for The Watch",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db dist/assets && cp src/db/schema.sql dist/db/schema.sql && cp src/assets/* dist/assets/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "tinypool": "^2.2.0",
    "esbuild": "^0.28.2",
    "vite": "^6.4.5",
    "@vitest/mocker": "^4.1.12"
  }
}
